<Window x:Class="MovieMaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:sys="clr-namespace:System.Windows;assembly=PresentationFramework"
        xmlns:conv="clr-namespace:MovieMaker.Converters"
        Title="Movie Maker" Height="800" Width="1280" MinWidth="1120" MinHeight="760"
        Background="Transparent"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Icon="pack://application:,,,/Assets/app.ico">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
    <conv:NullToVisibilityConverter x:Key="NullToVisibility"/>
    <conv:NullToVisibilityConverter x:Key="NotNullToVisibility" Inverse="True"/>
    <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringEmptyToVisibility"/>
    <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibility" Inverse="True"/>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

    <SolidColorBrush x:Key="TextPrimary" Color="#111827"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
    <SolidColorBrush x:Key="BorderSoft" Color="#E5E7EB"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AppBlue" Color="#1977F3"/>
    <SolidColorBrush x:Key="AppBlueSoft" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="DangerForeground" Color="#D92D20"/>
    <SolidColorBrush x:Key="WarningForeground" Color="#B54708"/>
    <SolidColorBrush x:Key="NeutralBackground" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="DangerBackground" Color="#FEE4E2"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#FECDCA"/>
    <SolidColorBrush x:Key="SuccessForeground" Color="#027A48"/>
    <SolidColorBrush x:Key="SuccessBackground" Color="#ECFDF3"/>
    <SolidColorBrush x:Key="SuccessBorder" Color="#ABEFC6"/>

    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBackground}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12"/>
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Background" Value="#7FB6E9"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#7FB6E9"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#C9DDF4"/>
          <Setter Property="BorderBrush" Value="#C9DDF4"/>
          <Setter Property="Foreground" Value="#F7F9FC"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,10"/>
      <Setter Property="MinHeight" Value="44"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="10">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#F9FAFB"/>
        </Trigger>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Background" Value="#F3F4F6"/>
          <Setter Property="Foreground" Value="#9CA3AF"/>
          <Setter Property="BorderBrush" Value="#E5E7EB"/>
          <Setter Property="Cursor" Value="Arrow"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="InlineButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="FontSize" Value="11"/>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
      <Setter Property="Width" Value="28"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Background" Value="#F3F4F6"/>
      <Setter Property="BorderBrush" Value="#E5E7EB"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E5E7EB"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TitleBarButtonBase" TargetType="Button">
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButtonBase}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#E5E7EB"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButtonBase}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#EF4444"/>
          <Setter Property="Foreground" Value="White"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TitleBarButtonMax" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TitleBarButtonRestore" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
      <Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
          <Setter Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Border Margin="8">
      <Border.Effect>
        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="0" Opacity="0.2"/>
      </Border.Effect>
      <Border Background="#F5F6F8" CornerRadius="12" ClipToBounds="True">
        <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="56"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="0,0,0,1"
            MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
      <Grid Margin="20,10,12,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AppBlue}" Margin="0,0,12,0">
            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Path Data="M 0 0 L 0 14 L 12 7 Z" Fill="White"/>
            </Viewbox>
          </Border>
          <StackPanel>
            <TextBlock Text="Movie Maker" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="画像と音楽から動画を作成" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Width="34" Height="34" Command="{Binding OpenSettingsCommand}" Margin="0,0,8,0"
                  Background="{StaticResource AppBlueSoft}" BorderBrush="{StaticResource AppBlueSoft}"
                  Foreground="{StaticResource AppBlue}" FontSize="16" Content="&#xE713;"
                  FontFamily="{StaticResource IconFont}"/>
          <Button Width="52" Height="34" Command="{Binding OpenLoudnessAnalysisCommand}" Margin="0,0,8,0"
                  Background="{StaticResource AppBlueSoft}" BorderBrush="{StaticResource AppBlueSoft}"
                  Foreground="{StaticResource AppBlue}" FontSize="10" FontWeight="Bold" Content="LUFS"
                  ToolTip="既存動画の音量解析"/>
          <Button Style="{StaticResource TitleBarButton}"
                  Click="MinimizeButton_OnClick"
                  Content="&#xE921;"/>
          <Button Style="{StaticResource TitleBarButtonMax}"
                  Click="MaximizeButton_OnClick"
                  Content="&#xE922;"/>
          <Button Style="{StaticResource TitleBarButtonRestore}"
                  Click="RestoreButton_OnClick"
                  Content="&#xE923;"/>
          <Button Style="{StaticResource CloseButton}"
                  Click="CloseButton_OnClick"
                  Content="&#xE8BB;"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="20,16,20,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="1.6*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="動画タイトル" Style="{StaticResource SectionTitle}"/>
          <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" MinHeight="38" Padding="10,6" FontSize="13"
                   BorderBrush="{StaticResource BorderSoft}" Background="White"
                   ToolTip="画像名から自動補完されます。必要に応じて編集できます。"/>
          <TextBlock Text="設定で出力先フォルダーを指定してください。" TextWrapping="Wrap" Margin="0,8,0,0"
                     Foreground="{StaticResource WarningForeground}" FontSize="12"
                     Visibility="{Binding OutputDirectoryPath, Converter={StaticResource StringEmptyToVisibility}}"/>
          <TextBlock Text="設定でアーカイブ先フォルダーを指定してください。" TextWrapping="Wrap" Margin="0,4,0,0"
                     Foreground="{StaticResource WarningForeground}" FontSize="12"
                     Visibility="{Binding ArchiveDirectoryPath, Converter={StaticResource StringEmptyToVisibility}}"/>
        </StackPanel>
        <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="16,0,0,0">
          <StackPanel>
            <TextBlock Text="出力モード" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
            <WrapPanel Margin="0,6,0,0">
              <CheckBox Content="仮動画を作る" IsChecked="{Binding UseDraftMode}"/>
              <TextBlock Text="通常動画 / Shorts は画像と音声から自動判定" Margin="12,0,0,0" Foreground="{StaticResource TextSecondary}"/>
            </WrapPanel>
            <TextBlock Text="{Binding InputStateMessage}" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsInputError}" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource DangerForeground}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <CheckBox Content="通常動画に曲名を文字入れする" IsChecked="{Binding NormalTextOverlayEnabled}" Margin="0,8,0,0"
                      Visibility="{Binding IsNormalOutput, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="通常動画としては尺が短い" Foreground="{StaticResource DangerForeground}" Margin="0,6,0,0"
                       Visibility="{Binding HasNormalLengthWarning, Converter={StaticResource BoolToVisibility}}"/>
            <WrapPanel Margin="0,6,0,0"
                        Visibility="{Binding UseDraftMode, Converter={StaticResource BoolToVisibility}}">
              <RadioButton Content="高音質 (44.1kHz / 256kbps)" IsChecked="{Binding IsDraftAudioQualityHigh}" Margin="0,0,16,0"/>
              <RadioButton Content="低音質 (32kHz / 128kbps)" IsChecked="{Binding IsDraftAudioQualityLow}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
      </Grid>
      <Grid Grid.Row="1" AllowDrop="True" Drop="DropArea_OnDrop" DragEnter="DropArea_OnDragEnter"
            DragOver="DropArea_OnDragOver" DragLeave="DropArea_OnDragLeave">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="16"/>
          <ColumnDefinition Width="330"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel LastChildFill="True">
              <Button DockPanel.Dock="Right" Content="チャプターを書き出し" Command="{Binding ExportAudioTrackListCommand}" Style="{StaticResource InlineButton}"/>
              <StackPanel>
                <TextBlock Text="音声トラック" Style="{StaticResource SectionTitle}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding AudioQueueSummaryText}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
              </StackPanel>
            </DockPanel>
            <WrapPanel Grid.Row="1" Margin="0,8,0,4">
              <Button Content="↑ 上へ" Command="{Binding MoveAudioTrackUpCommand}" Style="{StaticResource InlineButton}" Margin="0,0,6,4" ToolTip="選択した曲を上へ (Alt+↑)"/>
              <Button Content="↓ 下へ" Command="{Binding MoveAudioTrackDownCommand}" Style="{StaticResource InlineButton}" Margin="0,0,6,4" ToolTip="選択した曲を下へ (Alt+↓)"/>
              <Button Content="先頭へ" Command="{Binding MoveAudioTrackFirstCommand}" Style="{StaticResource InlineButton}" Margin="0,0,6,4" ToolTip="選択した曲を先頭へ (Alt+Home)"/>
              <Button Content="末尾へ" Command="{Binding MoveAudioTrackLastCommand}" Style="{StaticResource InlineButton}" Margin="0,0,0,4" ToolTip="選択した曲を末尾へ (Alt+End)"/>
            </WrapPanel>
            <TextBlock Grid.Row="2" Text="音声ファイル・フォルダーをドロップして追加" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="{Binding HasNoAudioTracks, Converter={StaticResource BoolToVisibility}}"/>
                <ListBox x:Name="AudioTrackList" Grid.Row="2" ItemsSource="{Binding AudioTracks}" SelectedItem="{Binding SelectedAudioTrack, Mode=TwoWay}" SelectionMode="Single" Margin="0,6,0,0"
                         BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding IsAudioReady, Converter={StaticResource BoolToVisibility}}"
                         AllowDrop="True" DragEnter="AudioTrackList_OnDragOver" DragOver="AudioTrackList_OnDragOver"
                         Drop="AudioTrackList_OnDrop" DragLeave="AudioTrackList_OnDragLeave">
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Margin" Value="0,0,0,3"/>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Border CornerRadius="6" Padding="5">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="#F9FAFB"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                <Setter Property="Background" Value="#E8F0FE"/>
                                <Setter Property="BorderBrush" Value="#1977F3"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsDropTargetBefore}" Value="True">
                                <Setter Property="BorderBrush" Value="#1977F3"/>
                                <Setter Property="BorderThickness" Value="1,3,1,1"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsDropTargetAfter}" Value="True">
                                <Setter Property="BorderBrush" Value="#1977F3"/>
                                <Setter Property="BorderThickness" Value="1,1,1,3"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="⋮⋮" Foreground="#94A3B8" FontSize="14" FontWeight="Bold" Cursor="SizeAll"
                                     VerticalAlignment="Center" HorizontalAlignment="Center" ToolTip="ドラッグして並べ替え"
                                     PreviewMouseLeftButtonDown="AudioTrackDragHandle_OnPreviewMouseLeftButtonDown"
                                     PreviewMouseMove="AudioTrackDragHandle_OnPreviewMouseMove"/>
                          <Border Grid.Column="1" Width="24" Height="24" CornerRadius="12" Background="#EEF2FF" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Position}" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                          </Border>
                          <StackPanel Grid.Column="2" Margin="6,0,8,0">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimary}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                              <TextBlock Grid.Column="1" Text="{Binding InfoText}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" VerticalAlignment="Center"/>
                              <Button Grid.Column="2" Content="{Binding NormalizationTargetSummaryText}" Margin="12,0,0,0"
                                      Style="{StaticResource InlineButton}" Click="EditTrackNormalization_OnClick"
                                      ToolTip="このトラックのノーマライズ目標を編集"
                                      Visibility="{Binding DataContext.IsStandardProfile, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"/>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" MinHeight="22" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal" Visibility="{Binding HasAudioMeasurements, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="{Binding LoudnessText}" FontSize="11" TextTrimming="CharacterEllipsis"
                                         Foreground="{StaticResource TextSecondary}"
                                         ToolTip="入力音量。-15 LUFS未満または-12 LUFS超は確認を推奨します">
                              </TextBlock>
                              <TextBlock Text="{Binding TruePeakText}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="12,0,0,0"
                                         Foreground="{StaticResource TextSecondary}"
                                         ToolTip="入力True Peak。-1 dBTP超は確認を推奨します">
                              </TextBlock>
                              <TextBlock Text="{Binding LoudnessRangeText}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="12,0,0,0"
                                         TextTrimming="CharacterEllipsis" ToolTip="入力LRA（参考値）"/>
                              </StackPanel>
                              <TextBlock Text="{Binding AudioMeasurementStateText}" Foreground="{StaticResource TextSecondary}" FontSize="11">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding HasAudioMeasurements}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                              <Button Content="{Binding AudioReviewReasonText}" Style="{StaticResource InlineButton}"
                                      Foreground="{StaticResource WarningForeground}" MinHeight="22" Padding="5,1" Margin="12,0,0,0"
                                      Click="AudioReviewDetails_OnClick"
                                      Visibility="{Binding HasAudioReviewWarning, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                          </StackPanel>
                          <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE711;" ToolTip="この音声を削除"
                                  Command="{Binding DataContext.RemoveAudioTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                  CommandParameter="{Binding}"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
            <StackPanel Grid.Row="3" Margin="0,8,0,0">
              <TextBlock Text="表示順に連結します。音声の追加は末尾、並べ替えはボタンまたはドラッグで行えます。"
                         TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
              <TextBlock Text="{Binding AudioLoudnessGuidanceText}" Foreground="{StaticResource TextSecondary}"
                         FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"
                         Visibility="{Binding IsAudioReady, Converter={StaticResource BoolToVisibility}}"/>
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="画像入力・確認" Style="{StaticResource SectionTitle}"/>
                <Grid Height="180" Background="#F9FAFB">
                  <Image Source="{Binding EffectiveImagePreview}" Stretch="Uniform" Margin="4"/>
                  <TextBlock Text="画像をドロップ&#x0a;JPG / PNG / WebP" TextAlignment="Center"
                             TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                             Foreground="{StaticResource TextSecondary}"
                             Visibility="{Binding EffectiveImagePreview, Converter={StaticResource NullToVisibility}}"/>
                </Grid>
                <TextBlock Text="{Binding ImageStatusText}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBackgroundAspectWarning}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource WarningForeground}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="入力画像の確認用です。文字入れ後の仕上がりは含みません。" TextWrapping="Wrap"
                           FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                <TextBlock Text="画像をドロップして差し替え" FontSize="11" Foreground="{StaticResource AppBlue}" Margin="0,4,0,0"
                           Visibility="{Binding ShowReplaceImageHint, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="画像を外す" Command="{Binding RemoveImageCommand}" Style="{StaticResource InlineButton}"
                        HorizontalAlignment="Left" Margin="0,8,0,0"/>
                <StackPanel Visibility="{Binding IsNormalOutput, Converter={StaticResource BoolToVisibility}}" Margin="0,8,0,0">
                  <StackPanel Visibility="{Binding NormalTextOverlayEnabled, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding TextOverlayLayoutStatusText}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                    <Button Content="文字入れJSONを編集" Command="{Binding OpenTextOverlayEditorCommand}" Style="{StaticResource InlineButton}"
                            HorizontalAlignment="Left" Margin="0,4,0,0"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
              <StackPanel>
                <TextBlock Text="生成動画" Style="{StaticResource SectionTitle}"/>
                <TextBlock Text="{Binding OutputStatusText}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                <Expander Header="エンコード設定の詳細" Margin="0,8,0,0">
                  <TextBlock Text="{Binding EncodingSettingsText}" TextWrapping="Wrap" FontSize="12" LineHeight="20"
                             Foreground="{StaticResource TextSecondary}" Margin="0,8,0,0"/>
                </Expander>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.ColumnSpan="3" Background="#E8F0FE" BorderBrush="#60A5FA" BorderThickness="2" CornerRadius="10"
                Panel.ZIndex="20" IsHitTestVisible="False"
                Visibility="{Binding IsFileDragOver, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding DropActionText}" FontSize="16" FontWeight="SemiBold" Foreground="#1977F3"
                     TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Border>
      </Grid>
      <Grid Grid.Row="2" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <WrapPanel VerticalAlignment="Center">
          <Button Content="設定" Command="{Binding OpenSettingsCommand}" Style="{StaticResource InlineButton}" Margin="0,0,8,4"
                  ToolTip="出力先・アーカイブ・ノーマライズなどを設定"/>
          <Button Content="出力フォルダーを開く" Command="{Binding OpenOutputFolderCommand}" Style="{StaticResource InlineButton}" Margin="0,0,8,4"/>
          <Button Content="入力をクリア" Command="{Binding ClearInputsCommand}" Style="{StaticResource InlineButton}" Margin="0,0,0,4"/>
        </WrapPanel>
        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="▶ エンコード開始"
                Command="{Binding EncodeCommand}" IsEnabled="{Binding CanEncode}" Margin="12,0,0,0"/>
      </Grid>
    </Grid>
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1,0,0,0">
          <Grid Margin="12,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>
            <ProgressBar Grid.Column="1" Width="120" Height="6" IsIndeterminate="True" Margin="8,0,0,0"
                         Visibility="{Binding IsEncoding, Converter={StaticResource BoolToVisibility}}"/>
          </Grid>
        </Border>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
